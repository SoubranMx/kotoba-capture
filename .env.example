# Machine-local configuration. The opt-in video_pilot CLI loads ignored .env.
# The original Tesseract CLI still requires explicit path arguments.
# Copy to an ignored .env and replace the placeholders for each machine.

KOTOBA_MEDIA_ROOT="/path/to/video-library"
KOTOBA_OBSIDIAN_VAULT_ROOT="/path/to/study-vault"

# Optional experiment data directory; interpret relative paths from the project root.
# The pilot resolves relative values from the project root, not the process cwd.
KOTOBA_EXPERIMENT_DATA_DIR=".local"

# Opt-in frozen v17 pilot: existing local assets only, no downloads.
# Models and policy must stay inside KOTOBA_EXPERIMENT_DATA_DIR.
KOTOBA_PILOT_DET_MODEL_DIR=".local/models/detector"
KOTOBA_PILOT_REC_MODEL_DIR=".local/models/recognizer"
KOTOBA_PILOT_POLICY_FILE=".local/profiles/manual.json"
KOTOBA_PILOT_PROFILE_ID="manual"
# cpu is the default. gpu:0 requires the isolated GPU PaddlePaddle runtime.
KOTOBA_PILOT_DEVICE=cpu
KOTOBA_PILOT_CPU_THREADS=10
KOTOBA_PILOT_INTERVAL=0.5
